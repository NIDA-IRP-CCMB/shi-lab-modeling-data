; Restraints
define                  = -DPOSRES -DPOSRES_FC_LIG=0 -DPOSRES_FC_UNC=0 -DPOSRES_FC_BMS=0  -DPOSRES_FC_BB_gp=2000.0 -DPOSRES_FC_BB=0.0 -DPOSRES_FC_SC_gp=0.0 -DPOSRES_FC_SC=0.0 -DPOSRES_FC_LIPID=0.0 -DDIHRES -DDIHRES_FC=0.0
integrator              = md
dt                      = 0.002
nsteps                  = 15000000
nstxout-compressed      = 500000   ; 30 frame in 30 ns
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstcalcenergy           = 100
nstenergy               = 1000
nstlog                  = 1000
;
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.0
vdwtype                 = Cut-off
vdw-modifier            = None
DispCorr                = EnerPres
rvdw                    = 1.2
coulombtype             = PME
rcoulomb                = 1.2
;
tcoupl                  = nose-hoover
tc_grps                 = SOLU MEMB SOLV
tau_t                   = 1.0 1.0 1.0
ref_t                   = 310 310 310
;
pcoupl                  = Parrinello-Rahman
pcoupltype              = semiisotropic
tau_p                   = 5.0
compressibility         = 4.5e-5  4.5e-5
ref_p                   = 0     1.0
refcoord_scaling        = all
;
constraints             = h-bonds
constraint_algorithm    = LINCS
continuation            = no
gen-vel                 = yes
gen-temp                = 310
gen-seed                = 10896
;
nstcomm                 = 100
comm_mode               = linear
comm_grps               = SOLU MEMB SOLV

