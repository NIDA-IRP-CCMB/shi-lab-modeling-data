define                  = -DPOSRES -DPOSRES_FC_LIG=2000 -DPOSRES_FC_UNC=4000 -DPOSRES_FC_BMS=4000 -DPOSRES_FC_BB_gp=4000.0 -DPOSRES_FC_BB=4000.0 -DPOSRES_FC_SC_gp=2000.0 -DPOSRES_FC_SC=2000.0 -DPOSRES_FC_LIPID=1000.0 -DDIHRES -DDIHRES_FC=1000.0
integrator              = steep
emtol                   = 1000.0
nsteps                  = 5000
nstlist                 = 10
cutoff-scheme           = Verlet
rlist                   = 1.0
vdwtype                 = Cut-off
vdw-modifier            = None
DispCorr                = EnerPres
rvdw                    = 1.2
coulombtype             = PME
rcoulomb                = 1.2
;
constraints             = h-bonds
constraint_algorithm    = LINCS
